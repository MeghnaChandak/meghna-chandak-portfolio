# Copy this file to .env and fill in the real backend URL.
# .env is gitignored so it won't be committed - VITE_API_URL isn't
# secret, but it's still good habit to keep environment-specific
# values out of committed code.

# While running the backend locally with `uvicorn main:app --reload`:
VITE_API_URL=http://localhost:8000

# Once you deploy the backend (Render/Koyeb/etc), replace with its real URL:
# VITE_API_URL=https://your-backend.onrender.com
